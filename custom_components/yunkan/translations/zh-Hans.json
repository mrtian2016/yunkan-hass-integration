  "services": {
    "ptz": {
      "name": "云台控制",
      "description": "让支持云台的摄像头朝某个方向短时移动。",
      "fields": {
        "direction": {
          "name": "方向",
          "description": "摄像头移动的方向。"
        },
        "speed": {
          "name": "速度",
          "description": "移动速度，0 到 1 之间。"
        },
        "duration": {
          "name": "时长",
          "description": "移动多少秒后停止。填 0 则持续移动直到下一条指令。"
        },
        "preset": {
          "name": "预置位",
          "description": "转到指定的预置位。"
        }
      }
    },
    "tts_broadcast": {
      "name": "语音喊话",
      "description": "通过文字转语音在摄像头喇叭上播报一段话（Pro 功能）。",
      "fields": {
        "message": {
          "name": "内容",
          "description": "要播报的文字。"
        },
        "voice": {
          "name": "音色",
          "description": "可选音色名称；留空则使用服务器默认。"
        },
        "rate": {
          "name": "语速",
          "description": "可选语速，例如 +10%。"
        },
        "pitch": {
          "name": "音调",
          "description": "可选音调，例如 +2Hz。"
        }
      }
    },
    "snapshot": {
      "name": "抓拍",
      "description": "从摄像头抓取一张最新画面并保存为文件。",
      "fields": {
        "filename": {
          "name": "文件名",
          "description": "保存 JPEG 的完整路径。所在目录需在 allowlist_external_dirs 中。"
        }
      }
    },
    "export": {
      "name": "导出录像",
      "description": "将某时间段的录像导出为可下载片段。",
      "fields": {
        "start": {
          "name": "开始",
          "description": "导出范围的起始时间。"
        },
        "end": {
          "name": "结束",
          "description": "导出范围的结束时间。"
        },
        "playback_factor": {
          "name": "播放倍速",
          "description": "实时，或 30 倍延时。"
        }
      }
    }
